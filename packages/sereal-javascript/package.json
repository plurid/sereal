{
    "name": "@plurid/sereal",
    "version": "0.0.0-1",
    "description": "Real (Values and Objects) Serialization",
    "keywords": [
        "sereal",
        "serialization",
        "serializer",
        "json",
        "class",
        "temporal",
        "bigint",
        "map",
        "set",
        "cycles",
        "migrations",
        "standard-schema"
    ],
    "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurid/sereal.git",
        "directory": "packages/sereal-javascript"
    },
    "bugs": {
        "email": "source@plurid.com",
        "url": "https://github.com/plurid/sereal/issues"
    },
    "homepage": "https://github.com/plurid/sereal/blob/master/packages/sereal-javascript",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public",
        "provenance": true
    },
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./timeline": {
            "types": "./dist/timeline.d.ts",
            "default": "./dist/timeline.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "source",
        "!source/**/__tests__"
    ],
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "test.watch": "vitest",
        "test.coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "smoke": "node scripts/smoke.ts",
        "smoke.all": "node scripts/smoke.ts && bun scripts/smoke.ts && deno run --allow-read scripts/smoke.ts",
        "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.5",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "fast-check": "^4.10.2",
        "publint": "^0.3.25",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2",
        "valibot": "^1.5.0",
        "vitest": "^5.1.0"
    }
}
